# Site block for the shared Caddy (e.g. /srv/edge/conf/sites/choidep.caddy).
# The app listens on 127.0.0.1:3201 (docker-compose.yml) and sets its own CSP.
# No access log on purpose: the privacy policy (/quyen-rieng-tu) promises IPs are not logged.
choidep.peti.vn {
	# Operator API: only the peti.vn admin on this server may call it (it goes to the app directly).
	respond /api/ops/* 404
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy 127.0.0.1:3201 {
		# The app trusts the first X-Forwarded-For hop (TRUST_PROXY=1): only this proxy may set it.
		header_up X-Forwarded-For {remote_host}
		header_up -CF-Connecting-IP
		health_uri /healthz
		health_interval 15s
	}
}
