# ---------- server ----------
PORT=3000
# Address players open (share links, QR codes), e.g. https://choidep.peti.vn
# Required (https) when NODE_ENV=production: the server refuses to start without it.
PUBLIC_URL=
# 1 when running behind Caddy/nginx (reads the real client IP from X-Forwarded-For)
TRUST_PROXY=0
NODE_ENV=development
DB_PATH=./data/choidep.sqlite

# ---------- limits ----------
MAX_ROOMS=200
MAX_ROOMS_PER_IP=3
ROOMS_CREATE_PER_MINUTE=5
MAX_SOCKETS_PER_IP=10
# Players across all rooms (each phone uses ~70 kbit/s: 1200 players ≈ 85 Mbit/s of upload)
MAX_PLAYERS_TOTAL=1200
ROOM_IDLE_MINUTES=30

# ---------- analytics (optional) ----------
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (same id as the other Peti sites). Empty = off.
GA4_ID=

# ---------- peti.vn admin dashboard (optional) ----------
# Same value as OPS_TOKEN in the peti.vn admin's .env (32+ characters). Empty = operator API off.
OPS_TOKEN=
